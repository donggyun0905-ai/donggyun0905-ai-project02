<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.specodyssey</groupId>
    <artifactId>spec-odyssey</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <djl.version>0.38.0</djl.version>
    </properties>

    <!-- DJL 모듈끼리 버전을 맞추기 위한 BOM -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ai.djl</groupId>
                <artifactId>bom</artifactId>
                <version>${djl.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 테스트: DAO 통합테스트용 JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Tomcat 10.1이 런타임에 제공 — jakarta.servlet.* -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!--
          테스트: JSP를 Tomcat 11의 Jasper로 미리 컴파일해 본다 (JspCompileTest).
          JSP는 톰캣이 요청받는 순간 컴파일하므로 보통의 단위 테스트로는 EL 문법 오류가 안 잡힌다.
          팀원 대부분이 10.1을 쓰는데 EL 버전이 달라(10.1=EL 5.0, 11=EL 6.0) 10.1에서 멀쩡한 표현식이
          11에서만 화면을 500으로 만든 적이 있다(2026-10-07 ${x.empty} — empty는 EL 예약어).
          그래서 로컬 톰캣이 아니라 11.0.25로 고정한다 — 10.1을 쓰는 사람 환경에서도 11 기준으로 검사된다.
          tomcat-servlet-api는 제외한다: 위의 jakarta.servlet-api 6.0.0과 같은 패키지라 테스트
          클래스패스에 둘이 같이 있으면 어느 쪽이 먼저 잡히는지에 따라 다른 테스트가 흔들린다.
        -->
        <dependency>
            <groupId>org.apache.tomcat</groupId>
            <artifactId>tomcat-jasper</artifactId>
            <version>11.0.25</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.tomcat</groupId>
                    <artifactId>tomcat-servlet-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- JspC는 Ant Task를 상속해서 ant가 클래스패스에 있어야 클래스 로딩이 된다 -->
        <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant</artifactId>
            <version>1.10.15</version>
            <scope>test</scope>
        </dependency>

        <!-- JSTL 3.0 (jakarta.tags.* taglib) — Tomcat이 기본 제공하지 않으므로 WAR에 포함 -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>3.0.1</version>
        </dependency>

        <!-- MySQL 8.0+ 드라이버 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>

        <!-- 커넥션 풀. 로깅은 slf4j → java.util.logging으로 흘려 보낸다 -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>1.7.36</version>
        </dependency>

        <!-- 비밀번호 해시: Argon2id (JDK 표준에 없음). Argon2 C 참조 구현을 JNA로 호출 — 주요 OS 네이티브 라이브러리가 jar에 포함 -->
        <dependency>
            <groupId>de.mkammerer</groupId>
            <artifactId>argon2-jvm</artifactId>
            <version>2.11</version>
        </dependency>

        <!-- 외부 API(워크넷·LLM·임베딩) 응답 JSON 파싱 -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

        <!-- 로드맵 SKILL 단계 학습 검증(공부노트·기술 설명 글) — 업로드된 PDF에서 텍스트를 꺼내 규칙 판정한다 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.31</version>
        </dependency>

        <!-- 로컬 임베딩 (TD-1): DJL + ONNX Runtime으로 ko-sroberta-multitask 실행. 모델 파일은 저장소 밖(EMBEDDING_MODEL_DIR) -->
        <dependency>
            <groupId>ai.djl</groupId>
            <artifactId>api</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.djl.onnxruntime</groupId>
            <artifactId>onnxruntime-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.djl.huggingface</groupId>
            <artifactId>tokenizers</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>spec-odyssey</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
