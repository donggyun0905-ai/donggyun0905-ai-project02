<?xml version="1.0" encoding="utf-8"?>
<!-- 설치 화면 한국어 문구 — jpackage 기본 영어 파일(MsiInstallerStrings_en.wxl)을 같은 이름으로 덮어써서 한국어로 보이게 한다. 문화권 en-us는 그대로, 코드 페이지만 949. build-companion.ps1이 resource-dir로 넘긴다 -->
<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization" Codepage="949">
  <String Id="MainFeatureTitle">스펙 오디세이 캐릭터</String>
  <String Id="DowngradeErrorMessage">더 새 버전의 [ProductName]이(가) 이미 설치되어 있어요. 설치를 마칩니다.</String>
  <String Id="DisallowUpgradeErrorMessage">이전 버전의 [ProductName]이(가) 이미 설치되어 있어 바꿀 수 없어요. 설치를 마칩니다.</String>

  <String Id="ShortcutPromptDlg_Title">[ProductName] 설치</String>
  <String Id="ShortcutPromptDlgTitle">{\WixUI_Font_Title}바로가기</String>
  <String Id="ShortcutPromptDlgBannerBitmap">WixUI_Bmp_Banner</String>
  <String Id="ShortcutPromptDlgDescription">만들 바로가기를 고르세요.</String>
  <String Id="ShortcutPromptDlgDesktopShortcutControlLabel">바탕화면 바로가기 만들기</String>
  <String Id="ShortcutPromptDlgStartMenuShortcutControlLabel">시작 메뉴 바로가기 만들기</String>

  <String Id="InstallDirNotEmptyDlg_Title">[ProductName] 설치</String>
  <String Id="InstallDirNotEmptyDlgInstallDirExistMessage">[INSTALLDIR] 폴더가 이미 있어요. 그래도 이 폴더에 설치할까요?</String>

  <String Id="ContextMenuCommandLabel">[ProductName](으)로 열기</String>

  <String Id="OsConditionMessage">[ProductName] [ProductVersion]은(는) 이 윈도우 버전에서 쓸 수 없어요.</String>
</WixLocalization>
