# 이 파일을 같은 폴더에 .env로 복사한 뒤 실제 값으로 채우세요.
# .env는 .gitignore(*.env)에 걸려 있어 커밋되지 않습니다 — 팀원끼리 공유하지 마세요.
DB_URL=jdbc:mysql://localhost:3306/spec_odyssey_test?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USER=root
DB_PASSWORD=

# [선택] 서류(DOCUMENTS) 업로드 파일 저장 폴더. 안 정해두면 <내 계정 홈>/spec-odyssey-uploads를 쓴다.
# webapp 안(css/js/image 등 공개 경로)에는 절대 두지 말 것 — 다른 사람이 URL로 남의 파일을 받을 수 있다.
# UPLOAD_DIR=C:/spec-odyssey-uploads

# 고용24 Open API 인증키 (API마다 따로 발급) — AppConfig가 읽는다.
# 채용정보(JOB_POSTING)는 고용24 기업회원 키만 동작한다. 개인회원 키는 "개인회원은 사용할 수 없는 OPEN-API" 오류.
WORK24_JOB_POSTING_API_KEY=
WORK24_MAJOR_INFO_API_KEY=
WORK24_EMPLOY_PROGRAM_API_KEY=
WORK24_JOB_INFO_API_KEY=
WORK24_DUTY_INFO_API_KEY=
WORK24_SMALL_GIANT_API_KEY=

# Groq LLM API 키 (트렌드 기술 정리·로드맵 PROJECT 단계 아이디어 생성용) — https://console.groq.com
GROQ_API_KEY=
# 선택: 모델 변경 시 (기본값 openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
# 선택: 자소서 첨삭 모델 (기본값 openai/gpt-oss-20b) — Groq 무료 한도는 모델마다 따로 세서, 트렌드 수집과 나눠 쓴다
# RESUME_FEEDBACK_MODEL=openai/gpt-oss-20b
# 선택: 수집에서 제외할 기술명 (쉼표로 구분)
# TREND_EXCLUDE_TECHS=

# [선택] 일일 미션 "정답 입력하기" 코드 컴파일 확인용 Judge0 — AppConfig가 읽는다.
# 비워 두면 Judge0 공식 무료 공개 서버(https://ce.judge0.com)를 키 없이 쓴다. 호출 횟수 제한이 있다.
# 다른 서버를 쓸 때만 채운다 — 직접 띄운 Judge0: JUDGE0_API_URL=http://localhost:2358
#                            RapidAPI: JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com + JUDGE0_API_KEY=발급키
# JUDGE0_API_URL=
# JUDGE0_API_KEY=

# [선택] 관리자 계정의 로그인 아이디. 안 정해두면 "admin".
# 이 아이디로 로그인하면 바로 관리자 화면(/admin)으로 가고, ☰ 메뉴에 "관리자"가 나온다(점수·주기 규칙 편집, 트렌드 재집계).
# 정식 역할 체계가 생기기 전까지 쓰는 방식이라, 배포 전에 이 아이디로 먼저 가입해 두거나 추측하기 어려운 값으로 바꿀 것.
# ADMIN_LOGIN_ID=admin

# [선택] 로컬 임베딩 모델 폴더 (ko-sroberta-multitask, DJL + ONNX Runtime). 저장소 밖에 두고 커밋하지 말 것 (약 440MB).
# 폴더에 model.onnx, tokenizer.json 두 파일이 있어야 한다. 받는 곳: https://huggingface.co/jhgan/ko-sroberta-multitask
#   - onnx/model.onnx → model.onnx
#   - tokenizer.json  → tokenizer.json
# EMBEDDING_MODEL_DIR=C:/models/ko-sroberta-multitask

# [선택] DB 커넥션 풀(HikariCP) 최대 크기. 안 넣으면 10 — 보통은 넣지 않아도 된다.
# 풀이 한 번에 DB에 열어 두는 연결의 최대 개수다. 팀원 여럿이 같은 공유 DB를 쓰니, (서버 켜는 사람 수 × 이 값)이
# DB의 max_connections(기본 151)를 넘지 않게 한다. 로컬에서 혼자 쓰면 5~10이면 충분하다.
# 동시 사용자가 늘어 "Connection is not available" 오류가 나면 키운다.
# DB_POOL_SIZE=10

# [선택] 개발·시연용 "[TEST] 파일 없이 통과" 버튼 — 로드맵 단계를 증빙 없이 바로 완료한다.
# 기본은 켜짐(안 넣으면 버튼이 보인다). 실제 서비스(운영) 배포에서는 반드시 false로 꺼서 증빙 규칙을 지킬 것.
# ENABLE_TEST_SHORTCUT=false
