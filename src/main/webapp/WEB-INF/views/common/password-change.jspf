<%-- 비밀번호 변경 카드 — 지원자 프로필과 면접관 프로필이 같이 쓴다. 쓰는 쪽이 페이지 변수 passwordAction(보낼 주소)을 정해 둔다.
     결과 문구(passwordMessage/passwordError)는 세션에 한 번만 실려 오며, 여기서 보여 주고 지운다. --%>
<c:if test="${not empty sessionScope.passwordMessage}">
    <p style="background:var(--teal-bg); color:var(--teal); border:1px solid rgba(31,122,108,0.3); border-radius:6px; padding:10px 14px; margin-top:24px;"><c:out value="${sessionScope.passwordMessage}" /></p>
    <c:remove var="passwordMessage" scope="session" />
</c:if>
<c:if test="${not empty sessionScope.passwordError}">
    <p class="error-message" style="margin-top:24px;"><c:out value="${sessionScope.passwordError}" /></p>
    <c:remove var="passwordError" scope="session" />
</c:if>
<div class="card" style="margin-top:24px;">
    <h2 style="margin-bottom:8px;">비밀번호 변경</h2>
    <p class="muted">현재 비밀번호를 확인한 뒤 새 비밀번호(8~100자)로 바꿉니다.</p>
    <form action="${pageContext.request.contextPath}${passwordAction}" method="post">
        <input type="hidden" name="_csrf" value="${csrfToken}">
        <p><label for="currentPassword">현재 비밀번호</label><input type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" required></p>
        <p><label for="newPassword">새 비밀번호</label><input type="password" id="newPassword" name="newPassword" minlength="8" maxlength="100" autocomplete="new-password" required></p>
        <p><label for="newPasswordConfirm">새 비밀번호 확인</label><input type="password" id="newPasswordConfirm" name="newPasswordConfirm" minlength="8" maxlength="100" autocomplete="new-password" required></p>
        <button type="submit">비밀번호 변경</button>
    </form>
</div>
