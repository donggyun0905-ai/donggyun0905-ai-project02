<%-- 관리자 화면 위쪽 탭 — adminTab: rules / trend --%>
<nav class="admin-tabs">
    <a href="${pageContext.request.contextPath}/admin" class="${adminTab == 'rules' ? 'active' : ''}">⚙️ 점수·주기 규칙</a>
    <a href="${pageContext.request.contextPath}/admin/job-skill-trend" class="${adminTab == 'trend' ? 'active' : ''}">📈 직무 기술 트렌드 재집계</a>
</nav>
<style>
    .admin-tabs { display: flex; gap: 8px; margin: 4px 0 18px; flex-wrap: wrap; }
    .admin-tabs a { padding: 8px 16px; border-radius: 999px; background: var(--card-bg); border: 1px solid var(--border);
        color: var(--ink); font-weight: 600; font-size: 0.92rem; }
    .admin-tabs a.active { background: var(--primary); border-color: var(--primary); color: #fff; }
</style>
