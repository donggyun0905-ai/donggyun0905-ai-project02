<%-- 여정 길 그림(2026-10-02) — 각 단계 마커의 중심을 부드러운 S자 곡선으로 이어 배경에 크게 깐다.
     점선 길은 전체, 흰 길은 "지금 위치"까지. 흰 빛이 시작점에서 지금 위치까지 길을 따라 움직이고,
     지나간 자리의 흰 길은 사라지지 않고 남는다. 지금 위치 = 지금 할 일(닻 마커)·완료 마커 중 가장 뒤쪽.
     카드·마커 위치가 바뀌는 창 크기 변경에서는 길만 다시 그리고 빛은 도착한 자리에 둔다.
     단계를 완료하면 페이지가 새로고침되는데, 그때마다 빛이 맨 처음부터 다시 달리면 안 된다 — 마지막으로 도착한 단계(step id)를
     브라우저에 기억해 두고, 새로고침 뒤에는 그 자리에서 새 위치까지만(보통 한 칸) 움직인다. 처음 방문(기억 없음)에만 처음부터 달린다.
     기억해 둔 단계가 지금 화면에 없거나(다른 로드맵·접힌 기록) 위치가 그대로이거나 뒤로 갔으면(완료 취소) 움직이지 않고 제자리에 둔다. --%>
<script>
// 길 그림은 .journey-track의 지금 내용(마커 위치)으로 그린다 — "길 더 만들기"로 길 부분을 갈아 끼운 뒤에는
// window.journeyPathInit()을 다시 불러 새 마커까지 다시 그린다.
window.journeyPathInit = function () {
(function () {
    var track = document.querySelector('.journey-track');
    if (!track) { return; }
    // 다시 그릴 때 이전 길 그림이 남아 겹치지 않게 지운다
    var stale = track.querySelector('svg.journey-path');
    if (stale) { stale.remove(); }
    var NS = 'http://www.w3.org/2000/svg';
    var svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('class', 'journey-path');
    svg.setAttribute('aria-hidden', 'true');
    track.insertBefore(svg, track.firstChild);
    var played = false;
    var STORE_KEY = 'journeyLightStep:' + (track.getAttribute('data-user-id') || '');

    function readStored() {
        try { return window.localStorage.getItem(STORE_KEY); } catch (e) { return null; }
    }
    function writeStored(stepId) {
        try { if (stepId) { window.localStorage.setItem(STORE_KEY, stepId); } } catch (e) { /* 저장을 못 해도 화면은 정상 */ }
    }

    function el(name, cls) {
        var node = document.createElementNS(NS, name);
        node.setAttribute('class', cls);
        svg.appendChild(node);
        return node;
    }

    function points() {
        var base = track.getBoundingClientRect();
        var markers = track.querySelectorAll('.journey-marker');
        var list = [];
        // 지금 위치 = 가장 멀리 간 곳 — 지금 할 일(닻 마커) 마커와 마지막 완료 마커 중 더 뒤쪽.
        // (위쪽 단계가 남은 채 아래쪽 단계를 먼저 끝내도 흰 길이 끝낸 곳까지 이어진다)
        var upTo = -1;
        markers.forEach(function (m, i) {
            var r = m.getBoundingClientRect();
            list.push({ x: r.left - base.left + r.width / 2, y: r.top - base.top + r.height / 2 });
            if (m.classList.contains('current') || m.classList.contains('completed')) { upTo = i; }
        });
        return { list: list, upTo: upTo };
    }

    function curve(list) {
        if (list.length === 0) { return ''; }
        var d = 'M' + list[0].x + ' ' + list[0].y;
        for (var i = 1; i < list.length; i++) {
            var a = list[i - 1], b = list[i], mid = (a.y + b.y) / 2;
            d += ' C' + a.x + ' ' + mid + ' ' + b.x + ' ' + mid + ' ' + b.x + ' ' + b.y;
        }
        return d;
    }

    function draw() {
        while (svg.firstChild) { svg.removeChild(svg.firstChild); }
        var p = points();
        if (p.list.length < 2) { return; }
        // 첫 마커 위쪽에서 길이 시작하도록 한 점을 더 둔다
        var first = p.list[0];
        var all = [{ x: first.x, y: Math.max(0, first.y - 70) }].concat(p.list);
        var upTo = p.upTo < 0 ? 0 : p.upTo + 1;

        el('path', 'path-base').setAttribute('d', curve(all));
        var doneD = curve(all.slice(0, upTo + 1));
        var done = el('path', 'path-done');
        done.setAttribute('d', doneD);
        var glow = el('circle', 'path-glow');
        glow.setAttribute('r', '11');

        var len = done.getTotalLength();
        // all[0..k]까지의 길(출발 보조점 포함)의 길이 — 빛이 출발할 자리를 재는 데 쓴다
        function lengthTo(k) {
            var tmp = document.createElementNS(NS, 'path');
            tmp.setAttribute('d', curve(all.slice(0, k + 1)));
            svg.appendChild(tmp);
            var l = tmp.getTotalLength();
            svg.removeChild(tmp);
            return l;
        }
        function place(at) {
            var pt = done.getPointAtLength(at);
            glow.setAttribute('cx', pt.x);
            glow.setAttribute('cy', pt.y);
        }
        // 흰 길은 점선 모양을 유지하면서 빛이 지난 만큼만 보이게 clip으로 드러낸다
        var clip = document.createElementNS(NS, 'clipPath');
        clip.setAttribute('id', 'journeyReveal');
        var rect = document.createElementNS(NS, 'rect');
        rect.setAttribute('x', '-1000'); rect.setAttribute('width', '4000'); rect.setAttribute('y', '0');
        clip.appendChild(rect);
        var defs = document.createElementNS(NS, 'defs');
        defs.appendChild(clip);
        svg.insertBefore(defs, svg.firstChild);
        done.setAttribute('clip-path', 'url(#journeyReveal)');

        function reveal(at) {
            var y = done.getPointAtLength(at).y;
            rect.setAttribute('height', Math.max(0, y + 12));
        }
        // 빛이 출발할 자리 — 기억해 둔 단계가 지금보다 앞이면 거기서, 기억이 없으면(처음) 맨 처음에서, 그 밖에는 움직이지 않는다
        var rows = track.querySelectorAll('.journey-row');
        var posStepId = rows[p.upTo] ? rows[p.upTo].getAttribute('data-step-id') : null;
        var stored = readStored();
        var fromLen = len; // 기본: 움직이지 않음
        if (stored === null) {
            fromLen = 0;
        } else {
            for (var r = 0; r < rows.length; r++) {
                if (rows[r].getAttribute('data-step-id') === stored) {
                    if (r < p.upTo) { fromLen = lengthTo(r + 1); }
                    break;
                }
            }
        }
        if (!played) { writeStored(posStepId); }

        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (played || reduce || len <= 0 || fromLen >= len - 0.5) {
            reveal(len); place(len); glow.classList.add('arrived');
            played = true;
            return;
        }
        played = true;
        reveal(fromLen); place(fromLen);
        var distance = len - fromLen;
        var duration = Math.min(5000, 1200 + distance * 2);
        var start = null;
        function frame(t) {
            if (start === null) { start = t; }
            var k = Math.min(1, (t - start) / duration);
            var eased = 1 - Math.pow(1 - k, 3);
            var at = fromLen + distance * eased;
            place(at);
            reveal(at);
            if (k < 1) { requestAnimationFrame(frame); } else { glow.classList.add('arrived'); }
        }
        requestAnimationFrame(frame);
    }

    // 곡선의 y가 위로 되돌아가지 않아(마커는 위→아래 순서) y 기준 clip이 빛을 정확히 따라간다.
    draw();
    var timer;
    window.addEventListener('resize', function () {
        clearTimeout(timer);
        timer = setTimeout(draw, 120);
    });
})();
};
window.journeyPathInit();
</script>
