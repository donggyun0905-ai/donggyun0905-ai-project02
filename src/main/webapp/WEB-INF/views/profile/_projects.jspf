<h2 style="margin-top:24px; margin-bottom:10px;">프로젝트 · 경험</h2>
<ul class="item-list">
    <c:forEach var="project" items="${projects}">
        <li>
            <strong><c:out value='${project.title}' /></strong>
            <c:if test="${not empty project.startDate or not empty project.endDate}"><span class="muted">(${project.startDate} ~ ${project.endDate})</span></c:if><br>
            <c:out value='${project.description}' /><br>
            <c:if test="${not empty project.techStack}">기술스택: ${project.techStack}</c:if>
            <c:if test="${not empty project.teamSize or not empty project.myRole}">
                <br><span class="muted"><c:if test="${not empty project.teamSize}">${project.teamSize == 1 ? '개인 프로젝트' : project.teamSize += '인 팀'}</c:if><c:if test="${not empty project.teamSize and not empty project.myRole}"> · </c:if><c:out value='${project.myRole}' /></span>
            </c:if>
            <c:if test="${not empty project.repoUrl or not empty project.deployUrl or not empty projectLinks[project.id]}">
                <br><span class="ic ic-link" aria-hidden="true"></span>
                <c:if test="${not empty project.repoUrl}"><a href="<c:out value='${project.repoUrl}' />" target="_blank" rel="noopener noreferrer">저장소</a></c:if>
                <c:if test="${not empty project.deployUrl}"> · <a href="<c:out value='${project.deployUrl}' />" target="_blank" rel="noopener noreferrer">배포</a></c:if>
                <c:forEach var="link" items="${projectLinks[project.id]}"> · <a href="<c:out value='${link.url}' />" target="_blank" rel="noopener noreferrer"><c:out value="${link.displayName}" /></a></c:forEach>
            </c:if>
            <c:forEach var="doc" items="${documents}">
                <c:if test="${doc.projectId == project.id}">
                    <br><a href="${pageContext.request.contextPath}/documents/${doc.id}" class="file-link"><span class="ic ic-paperclip" aria-hidden="true"></span> <c:out value='${doc.originalName}' /></a>
                </c:if>
            </c:forEach>
            <div class="row" style="margin-top:8px;">
                <details class="inline-form">
                    <summary>수정</summary>
                    <form action="${pageContext.request.contextPath}/profile/projects" method="post">
                        <input type="hidden" name="_csrf" value="${csrfToken}">
                        <input type="hidden" name="action" value="update">
                        <input type="hidden" name="projectId" value="${project.id}">
                        <p><input type="text" name="title" value="<c:out value='${project.title}' />" placeholder="프로젝트명" required></p>
                        <p><textarea name="description" placeholder="설명"><c:out value='${project.description}' /></textarea></p>
                        <p><input type="text" name="techStack" value="<c:out value='${project.techStack}' />" placeholder="사용 기술 (예: Java, Spring, MySQL)"></p>
                        <p class="row">
                            <span style="flex:1;">시작일 <input type="date" name="startDate" value="${project.startDate}"></span>
                            <span style="flex:1;">종료일 <input type="date" name="endDate" value="${project.endDate}"></span>
                        </p>
                        <%-- 면접관 뷰에서 기여도로 보이는 값 — 팀 인원(본인 포함)과 내가 맡은 역할 --%>
                        <p class="row">
                            <span style="flex:1;">팀 인원 <input type="number" name="teamSize" min="1" max="100" value="${project.teamSize}" placeholder="1이면 개인"></span>
                            <span style="flex:2;">내 역할 <input type="text" name="myRole" maxlength="100" value="<c:out value='${project.myRole}' />" placeholder="예) 백엔드 API · DB 설계"></span>
                        </p>
                        <p class="row">
                            <span style="flex:1;"><input type="url" name="repoUrl" maxlength="500" value="<c:out value='${project.repoUrl}' />" placeholder="코드 저장소 링크 (선택)"></span>
                            <span style="flex:1;"><input type="url" name="deployUrl" maxlength="500" value="<c:out value='${project.deployUrl}' />" placeholder="배포 주소 (선택)"></span>
                        </p>
                        <c:set var="linkRows" value="${projectLinks[project.id]}" />
<%@ include file="/WEB-INF/views/common/project-link-fields.jspf" %>
                        <button type="submit">저장</button>
                    </form>
                </details>
                <form action="${pageContext.request.contextPath}/profile/projects" method="post" class="inline-form">
                    <input type="hidden" name="_csrf" value="${csrfToken}">
                    <input type="hidden" name="action" value="delete">
                    <input type="hidden" name="projectId" value="${project.id}">
                    <button type="submit" class="link-button">삭제</button>
                </form>
            </div>
        </li>
    </c:forEach>
</ul>
<div class="card">
    <form action="${pageContext.request.contextPath}/profile/projects" method="post">
        <input type="hidden" name="_csrf" value="${csrfToken}">
        <p><input type="text" name="title" placeholder="프로젝트명" required></p>
        <p><textarea name="description" placeholder="설명"></textarea></p>
        <p><input type="text" name="techStack" placeholder="사용 기술 (예: Java, Spring, MySQL)"></p>
        <p class="row">
            <span style="flex:1;">시작일 <input type="date" name="startDate"></span>
            <span style="flex:1;">종료일 <input type="date" name="endDate"></span>
        </p>
        <p class="row">
            <span style="flex:1;">팀 인원 <input type="number" name="teamSize" min="1" max="100" placeholder="1이면 개인"></span>
            <span style="flex:2;">내 역할 <input type="text" name="myRole" maxlength="100" placeholder="예) 백엔드 API · DB 설계"></span>
        </p>
        <p class="row">
            <span style="flex:1;"><input type="url" name="repoUrl" maxlength="500" placeholder="코드 저장소 링크 (선택)"></span>
            <span style="flex:1;"><input type="url" name="deployUrl" maxlength="500" placeholder="배포 주소 (선택)"></span>
        </p>
        <c:set var="linkRows" value="${null}" />
<%@ include file="/WEB-INF/views/common/project-link-fields.jspf" %>
        <button type="submit">프로젝트 추가</button>
    </form>
</div>